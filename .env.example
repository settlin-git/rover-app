# Copy this file to `.env` and fill in real values. `.env` is git-ignored, so
# your keys never leave your machine. Restart `npm start` after changing it —
# environment variables are only read when the dev server starts.
#
# The EXPO_PUBLIC_ prefix is required for a variable to reach the app. It also
# means the value ships inside the app bundle and is readable by anyone who
# downloads it, so only ever put publishable keys here. Never a secret or
# service-role key.

# Supabase — see docs/09-backend.md. Both come from your project's Connect panel.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
